# Скопировать в защищённый /etc/octopus/browser-aios-adapter.env; не коммитить реальные значения.
OCTOPUS_BROWSER_PRIMARY_CDP_URL=http://127.0.0.1:9222
OCTOPUS_BROWSER_SECONDARY_CDP_URL=http://127.0.0.1:9224
OCTOPUS_BROWSER_VISION_PROVIDER=gemini
OCTOPUS_BROWSER_GEMINI_MODEL=gemini-2.5-flash
OCTOPUS_BROWSER_GROQ_MODEL=qwen/qwen3.8-27b
# Optional OpenAI-compatible LLM balancer, e.g. Arena Gateway:
# OCTOPUS_BROWSER_LLM_BALANCER_URL=http://127.0.0.1:13014/v1
# OCTOPUS_BROWSER_LLM_BALANCER_MODEL=auto
OCTOPUS_BROWSER_ACTION_REQUIRE_APPROVAL=1
OCTOPUS_BROWSER_ALLOW_EXTERNAL_VISION=0
# GEMINI_API_KEY=...
# GROQ_API_KEY=...
# OCTOPUS_BROWSER_LLM_BALANCER_API_KEY=...
