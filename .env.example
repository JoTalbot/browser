# 🐙 Octopus Browser — пример переменных окружения
# Копируйте в .env (gitignored). Никогда не выкладывайте реальные секреты!

APP_HOST=0.0.0.0
APP_PORT=8090
DATA_DIR=./data

# 🌐 Браузер
BROWSER=chromium
HEADLESS=true
DEFAULT_PROFILE=main

# 🕒 Human-like pacing
HUMAN_MIN_DELAY=0.4
HUMAN_MAX_DELAY=1.6

# 🤖 Vision-модель (OpenAI-совместимый эндпоинт)
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=gpt-4o
AGENT_MAX_STEPS=30

# 🕵️ Прокси (через запятую)
PROXY_LIST=
